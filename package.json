{
	"name": "skyline",
	"private": true,
	"version": "1.0.0",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "pnpm --filter=@skyline/app run dev",
		"neat": "oxlint && oxfmt --check",
		"neat:fix": "oxlint --fix && oxfmt",
		"typecheck": "tsc -p packages/app && tsc -p packages/worker",
		"clean:dist": "rm -rf ./packages/**/dist packages/**/tsconfig.tsbuildinfo",
		"clean:packages": "rm -rf packages/**/node_modules node_modules"
	},
	"devDependencies": {
		"oxfmt": "^0.80.0",
		"oxlint": "^1.95.0",
		"typescript": "^7.0.2"
	},
	"volta": {
		"node": "22.14.0",
		"pnpm": "10.15.0"
	}
}
